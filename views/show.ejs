<!DOCTYPE html>
<html lang="pt-br">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Registros</title><link rel="stylesheet" href="/style.css"></head>
<body><main class="container">
  <h2>Registros</h2>
  <table border="1" cellpadding="8">
    <thead><tr><th>Nome</th><th>Sobrenome</th><th>Ações</th></tr></thead>
    <tbody>
      <% if (crud.length === 0) { %><tr><td colspan="3">Nenhum registro cadastrado.</td></tr><% } %>
      <% crud.forEach(function(details) { %>
        <tr>
          <td><%= details.name %></td>
          <td><%= details.surname %></td>
          <td>
            <a href="/edit/<%= details._id %>">Editar</a>
            <form action="/delete/<%= details._id %>" method="POST" style="display:inline" class="delete-form" onsubmit="return confirm('Excluir este registro?')">
              <button class="danger" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <p><a href="/index">Cadastrar nova pessoa</a></p>
</main></body>
</html>
